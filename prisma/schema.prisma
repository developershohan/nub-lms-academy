// Prisma schema for NUB Academy LMS
// Phase 1: auth, roles, permissions foundation.
// Phase 2: course catalog (courses, sections, lessons, categories).
// Quiz/payment/chat models are added in later phases.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum RoleName {
  STUDENT
  TEACHER
  ADMIN
  SUPER_ADMIN
  // Manually assigned, like ADMIN/SUPER_ADMIN - handles Support conversations and chat
  // moderation only, not the rest of the admin panel (see src/lib/permissions.ts).
  SUPPORT
}

enum TeacherApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  phone         String?
  address       String?
  status        UserStatus @default(ACTIVE)
  /// Bumped on ban, password change and password reset. Every JWT carries the version it was
  /// issued under and is rejected once they differ, so those events sign out every session.
  sessionVersion Int       @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  accounts       Account[]
  sessions       Session[]
  roles          UserRole[]
  teacherProfile TeacherProfile?
  bans           UserBan[]        @relation("BannedUser")
  bansIssued     UserBan[]        @relation("BannedBy")
  courses        Course[]
  enrollments    Enrollment[]
  lessonProgress LessonProgress[]
  lessonNotes    LessonNote[]
  reviews        CourseReview[]
  wishlist       Wishlist[]
  courseViews    CourseView[]
  quizAttempts   QuizAttempt[]
  certificates   Certificate[]
  orders         Order[]
  couponRedemptions CouponRedemption[]
  subscriptions  Subscription[]
  conversationParticipants ConversationParticipant[]
  messages                 Message[]
  notifications            Notification[]
  notificationPreferences  NotificationPreference[]
  pushSubscriptions        PushSubscription[]
  messageReactions         MessageReaction[]
  blocksMade               UserBlock[]              @relation("BlocksMade")
  blockedBy                UserBlock[]              @relation("BlockedBy")
  reportsFiled             Report[]                 @relation("ReportsFiled")
  reportsAgainst           Report[]                 @relation("ReportsAgainst")
  supportTicketsRequested  SupportTicket[]          @relation("SupportTicketsRequested")
  supportTicketsAssigned   SupportTicket[]          @relation("SupportTicketsAssigned")
  lessonQuestions          LessonQuestion[]
  lessonAnswers            LessonAnswer[]
  lessonQuestionVotes      LessonQuestionVote[]
  subInstructorOf          CourseInstructor[] @relation("SubInstructorUser")
  addedSubInstructors      CourseInstructor[] @relation("SubInstructorAddedBy")

  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Role {
  id    String     @id @default(cuid())
  name  RoleName   @unique
  users UserRole[]
}

model UserRole {
  userId String
  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model TeacherProfile {
  id        String                   @id @default(cuid())
  userId    String                   @unique
  status    TeacherApplicationStatus @default(PENDING)
  headline  String?
  bio       String?                  @db.Text
  appliedAt DateTime                 @default(now())
  reviewedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserBan {
  id         String   @id @default(cuid())
  userId     String
  bannedById String?
  reason     String
  createdAt  DateTime @default(now())

  user     User  @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  bannedBy User? @relation("BannedBy", fields: [bannedById], references: [id], onDelete: SetNull)

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([actorId])
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ALL_LEVELS
}

enum CourseStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
  ARCHIVED
}

enum LessonType {
  VIDEO
  TEXT
}

enum VideoStatus {
  UPLOADING
  PROCESSING
  READY
  FAILED
}

model Category {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  courses Course[]
}

model Course {
  id                     String       @id @default(cuid())
  title                  String
  slug                   String       @unique
  subtitle               String?
  description            String?      @db.Text
  thumbnailUrl           String?
  targetAudience         String?      @db.Text
  level                  CourseLevel  @default(ALL_LEVELS)
  language               String       @default("English")
  price                  Decimal      @default(0) @db.Decimal(10, 2)
  salePrice              Decimal?     @db.Decimal(10, 2)
  isSubscriptionIncluded Boolean      @default(false)
  isFeatured             Boolean      @default(false)
  status                 CourseStatus @default(DRAFT)
  rejectionReason        String?
  publishedAt            DateTime?
  /// Set when the teacher edits an APPROVED or PUBLISHED course (details, price, lessons), so an
  /// admin re-reviews it; cleared by "Mark reviewed". The course stays live meanwhile.
  changedSinceReviewAt   DateTime?
  /// Denormalised for catalogue search, sorting and filtering - recomputed by refreshCourseStats
  /// (src/server/services/course-stats-service.ts) whenever reviews, lessons or prices change.
  ratingAvg              Float        @default(0)
  ratingCount            Int          @default(0)
  totalDurationSec       Int          @default(0)
  lessonCount            Int          @default(0)
  /// salePrice ?? price - what checkout actually charges, so catalogue price sorts and filters are right.
  effectivePrice         Decimal      @default(0) @db.Decimal(10, 2)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  teacherId  String
  teacher    User      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  sections      CourseSection[]
  requirements  CourseRequirement[]
  outcomes      CourseOutcome[]
  enrollments   Enrollment[]
  reviews       CourseReview[]
  wishlistedBy  Wishlist[]
  views         CourseView[]
  quizzes       Quiz[]
  certificates  Certificate[]
  orderItems    OrderItem[]
  coupons       Coupon[]
  conversations Conversation[]
  instructors   CourseInstructor[]
  lessonQuestions LessonQuestion[]

  @@index([status])
  @@index([status, isFeatured])
  @@index([status, ratingAvg])
  @@index([status, effectivePrice])
  @@index([teacherId])
  @@index([categoryId])
}

/** A sub-instructor assigned by the owning teacher (canManageCourse) - chat/support access on
 * this course only (can be listed as a contact, can message students), not content edit rights.
 * The owning teacher themselves is Course.teacher, not a row here. */
model CourseInstructor {
  id        String   @id @default(cuid())
  courseId  String
  userId    String
  addedById String
  createdAt DateTime @default(now())

  course  Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user    User   @relation("SubInstructorUser", fields: [userId], references: [id], onDelete: Cascade)
  addedBy User   @relation("SubInstructorAddedBy", fields: [addedById], references: [id], onDelete: Cascade)

  @@unique([courseId, userId])
  @@index([userId])
}

model CourseRequirement {
  id        String @id @default(cuid())
  courseId  String
  content   String
  sortOrder Int    @default(0)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model CourseOutcome {
  id        String @id @default(cuid())
  courseId  String
  content   String
  sortOrder Int    @default(0)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId])
}

model CourseSection {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course  Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons Lesson[]

  @@index([courseId])
}

model Lesson {
  id          String     @id @default(cuid())
  sectionId   String
  title       String
  type        LessonType @default(TEXT)
  content     String?    @db.Text
  durationSec Int?
  sortOrder   Int        @default(0)
  isPreview   Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  section    CourseSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  videoAsset VideoAsset?
  progress   LessonProgress[]
  notes      LessonNote[]
  quiz       Quiz?
  questions  LessonQuestion[]

  @@index([sectionId])
}

model VideoAsset {
  id              String      @id @default(cuid())
  lessonId        String      @unique
  provider        String      @default("external")
  providerAssetId String?
  playbackUrl     String
  durationSec     Int?
  status          VideoStatus @default(READY)
  uploadedById    String
  createdAt       DateTime    @default(now())

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
}

enum EnrollmentStatus {
  ACTIVE
  EXPIRED
  REFUNDED
  CANCELLED
  REVOKED
}

enum EnrollmentSource {
  FREE
  PURCHASE
  SUBSCRIPTION
  ADMIN_GRANT
  COUPON
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  courseId    String
  status      EnrollmentStatus @default(ACTIVE)
  source      EnrollmentSource @default(FREE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model LessonProgress {
  id             String    @id @default(cuid())
  userId         String
  lessonId       String
  watchedSeconds Int       @default(0)
  completed      Boolean   @default(false)
  completedAt    DateTime?
  /// When the student last opened this lesson in the player - the learn page resumes there.
  lastViewedAt   DateTime?
  updatedAt      DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

/// A student's private notes on one lesson (one notepad per student per lesson). Only the author
/// ever reads them, and saving requires lesson access (canAccessLesson).
model LessonNote {
  id        String   @id @default(cuid())
  userId    String
  lessonId  String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([lessonId])
}

model CourseReview {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  rating    Int
  comment   String?  @db.Text
  hidden    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  courseId  String
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([courseId])
}

/// The last time a signed-in user opened a course's landing page - feeds "Because you viewed" on
/// their home page. One row per user and course; a repeat visit only moves viewedAt.
model CourseView {
  userId   String
  courseId String
  viewedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([userId, courseId])
  @@index([userId, viewedAt])
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  /// Options are the accepted answers (never shown); a typed answer matches ignoring case and spacing.
  FILL_BLANK
  /// Options in their correct order (sortOrder); students see them shuffled and put them back in order.
  ORDERING
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
}

model Quiz {
  id                String    @id @default(cuid())
  courseId          String
  lessonId          String?   @unique
  title             String
  description       String?   @db.Text
  passingScore      Int       @default(70)
  maxAttempts       Int?
  timeLimitSec      Int?
  sortOrder         Int       @default(0)
  shuffleQuestions  Boolean   @default(false)
  shuffleOptions    Boolean   @default(false)
  /// Question bank: each attempt draws this many questions at random. Null = every question.
  drawCount         Int?
  /// Multiple-choice and ordering questions earn a share of their points for partly right answers.
  partialCredit     Boolean   @default(false)
  /// Minutes a student waits after submitting before they can start another attempt.
  retakeCooldownMin Int?
  /// Set instead of deleting a quiz students have already taken, so their attempt history survives.
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson    Lesson?       @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  questions Question[]
  attempts  QuizAttempt[]

  @@index([courseId])
}

model Question {
  id        String       @id @default(cuid())
  quizId    String
  prompt    String       @db.Text
  type      QuestionType @default(SINGLE_CHOICE)
  points    Int          @default(1)
  sortOrder Int          @default(0)

  quiz    Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  options QuestionOption[]

  @@index([quizId])
}

model QuestionOption {
  id         String  @id @default(cuid())
  questionId String
  content    String
  isCorrect  Boolean @default(false)
  sortOrder  Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model QuizAttempt {
  id             String            @id @default(cuid())
  quizId         String
  userId         String
  status         QuizAttemptStatus @default(IN_PROGRESS)
  score          Int?
  passed         Boolean?
  startedAt      DateTime          @default(now())
  submittedAt    DateTime?
  /// When answers stop being accepted (plus a short grace for the last request in flight). Fixed
  /// at start, so changing the quiz's time limit never moves an open attempt's deadline.
  deadlineAt     DateTime?
  /// The questions as this attempt was given them - drawn, shuffled, with the answer key - so
  /// later quiz edits never change how it was graded or what its history shows. See lib/quiz-grading.ts.
  snapshot       Json?
  /// Graded by the server from saved answers because time ran out before the student submitted.
  autoSubmitted  Boolean           @default(false)
  pointsEarned   Float?
  pointsPossible Float?

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@index([quizId, userId])
}

/// One answer in an attempt. questionId points into the attempt's snapshot rather than a live
/// Question row, so deleting or editing a question never deletes or rewrites past answers.
model QuizAnswer {
  id                String   @id @default(cuid())
  attemptId         String
  questionId        String
  /// Chosen option ids - or, for ORDERING, the option ids in the order the student put them.
  selectedOptionIds String[]
  /// FILL_BLANK only.
  textAnswer        String?
  isCorrect         Boolean  @default(false)
  pointsAwarded     Float    @default(0)

  attempt QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model Certificate {
  id                String    @id @default(cuid())
  certificateNumber String    @unique
  userId            String
  courseId          String
  // Snapshot fields so a certificate stays a stable historical record even if the
  // student renames themselves or the course/teacher details change later.
  studentName       String
  courseTitle       String
  teacherName       String
  completedAt       DateTime
  issuedAt          DateTime  @default(now())
  revoked           Boolean   @default(false)
  revokedAt         DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
  /// A chargeback is open in Stripe: access is suspended until it closes (won -> PAID, lost -> REFUNDED).
  DISPUTED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CouponAppliesTo {
  ALL_COURSES
  SPECIFIC_COURSE
  SUBSCRIPTION
}

model Order {
  id                      String      @id @default(cuid())
  userId                  String
  status                  OrderStatus @default(PENDING)
  subtotal                Decimal     @db.Decimal(10, 2)
  discountAmount          Decimal     @default(0) @db.Decimal(10, 2)
  total                   Decimal     @db.Decimal(10, 2)
  currency                String      @default("usd")
  couponId                String?
  stripeCheckoutSessionId String?     @unique
  stripePaymentIntentId   String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon   Coupon?     @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([status])
  @@index([stripePaymentIntentId])
}

model OrderItem {
  id       String  @id @default(cuid())
  orderId  String
  courseId String
  price    Decimal @db.Decimal(10, 2)

  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([courseId])
}

/** Append-only event log for Stripe webhook events, keyed on stripeEventId for idempotency -
 * Order.status is the single source of truth for the order's current state. */
model Payment {
  id            String      @id @default(cuid())
  orderId       String
  amount        Decimal     @db.Decimal(10, 2)
  currency      String      @default("usd")
  status        OrderStatus
  stripeEventId String?     @unique
  createdAt     DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model Coupon {
  id             String           @id @default(cuid())
  code           String           @unique
  discountType   DiscountType
  discountValue  Decimal          @db.Decimal(10, 2)
  appliesTo      CouponAppliesTo  @default(ALL_COURSES)
  courseId       String?
  maxRedemptions Int?
  perUserLimit   Int?             @default(1)
  startsAt       DateTime?
  expiresAt      DateTime?
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  course      Course?            @relation(fields: [courseId], references: [id], onDelete: SetNull)
  redemptions CouponRedemption[]
  orders      Order[]

  @@index([code])
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String   @unique
  createdAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([couponId, userId])
}

enum SubscriptionInterval {
  MONTH
  YEAR
}

/// ponytail: Stripe's canceled/unpaid/incomplete_expired all collapse into CANCELLED here - split
/// out a separate EXPIRED state later if the product needs to distinguish "user canceled" from
/// "payment failed past the grace period".
enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
}

model SubscriptionPlan {
  id        String               @id @default(cuid())
  name      String
  interval  SubscriptionInterval
  price     Decimal              @db.Decimal(10, 2)
  active    Boolean              @default(true)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  subscriptions Subscription[]
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String
  planId               String
  status               SubscriptionStatus @default(ACTIVE)
  stripeCustomerId     String?
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

enum ConversationType {
  DIRECT
  COURSE_GROUP
  SUPPORT
}

/// A course community's channels. GENERAL is the course group every course has had so far
/// ("course:<courseId>"); the others are "course:<courseId>:announcements", ":qa" and ":batch:<slug>".
enum ConversationChannel {
  GENERAL
  ANNOUNCEMENTS
  QA
  BATCH
}

model Conversation {
  id            String           @id @default(cuid())
  type          ConversationType
  courseId      String?
  /// Stops concurrent opens from creating duplicates: "direct:<userA>:<userB>" (ids sorted),
  /// "course:<courseId>" (+ ":announcements", ":qa", ":batch:<slug>"), "support:<userId>".
  /// Null only on legacy duplicates.
  uniqueKey     String?          @unique
  /// COURSE_GROUP only: which channel of the course community this is.
  channel       ConversationChannel?
  /// Batch channels carry a label ("Batch 7, Jan 2027"); other conversations are named live.
  title         String?
  /// Only OWNER and MODERATOR participants may post (the #announcements channel).
  announcementOnly Boolean       @default(false)
  /// Members may post at most once per this many seconds; 0 is off. Moderators are exempt.
  slowModeSec   Int              @default(0)
  pinnedMessageId String?
  /// Seq of the newest message - each message takes the next one. Unread = lastSeq - lastReadSeq.
  lastSeq       Int              @default(0)
  lastMessageAt DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  course        Course?                   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  participants  ConversationParticipant[]
  messages      Message[]
  supportTicket SupportTicket?

  @@index([courseId])
  @@index([type])
}

enum ParticipantRole {
  OWNER
  MODERATOR
  MEMBER
}

model ConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  /// Seq of the newest message this member has seen. Replaces per-message read receipts.
  lastReadSeq    Int       @default(0)
  /// The course's teacher owns its channels, co-instructors moderate, everyone else is a member.
  role           ParticipantRole @default(MEMBER)
  /// Set by the member: no notifications for this conversation until then.
  mutedUntil     DateTime?
  /// Set by a moderator of a course channel: the member can read but not post until then.
  postingBlockedUntil DateTime?
  /// Membership follows course access: a refund, revocation or removal sets this instead of
  /// deleting the row, so the read position survives a re-enrollment.
  removedAt      DateTime?
  /// Set when a moderator removed them (holds until access itself changes); null when access was lost.
  removedById    String?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, removedAt])
}

enum MessageType {
  TEXT
  /// A note the system wrote ("Sam marked this ticket as resolved"), shown centred and grey.
  SYSTEM
}

/// deletedAt covers both a sender's own soft delete and admin moderation (chat:moderate) - either
/// way the content is hidden and replaced with a placeholder, so there's no need for two flags.
model Message {
  id             String    @id @default(cuid())
  conversationId String
  /// 1, 2, 3... per conversation, in send order. Clients ask for "everything after seq N" when
  /// they reconnect, so nothing sent while they were away is missed.
  seq            Int
  senderId       String
  /// Chosen by the sending browser; a retried send with the same id returns the saved message
  /// instead of posting it twice.
  clientMsgId    String?
  type           MessageType @default(TEXT)
  content        String    @db.Text
  replyToId      String?
  editedAt       DateTime?
  /// First report, for a quick admin filter; the reports themselves are Report rows.
  reportedAt     DateTime?
  reportReason   String?
  deletedAt      DateTime?
  /// Who removed it: the sender (own delete) or a moderator. Either way the text stays on the server.
  deletedById    String?
  createdAt      DateTime  @default(now())

  conversation Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      Message[]         @relation("MessageReplies")
  reactions    MessageReaction[]
  reports      Report[]

  @@unique([conversationId, seq])
  @@unique([senderId, clientMsgId])
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  emoji     String
  createdAt DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

/// A block stops new direct messages in both directions; existing history stays readable.
model UserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlockedBy", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

enum ReportTargetType {
  MESSAGE
  USER
  REVIEW
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

/// Reports for staff to review. reviewId is a plain id (no relation) so the course models stay untouched.
model Report {
  id           String           @id @default(cuid())
  reporterId   String?
  targetType   ReportTargetType
  messageId    String?
  targetUserId String?
  reviewId     String?
  reason       String?
  status       ReportStatus     @default(OPEN)
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime         @default(now())

  reporter   User?    @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: SetNull)
  targetUser User?    @relation("ReportsAgainst", fields: [targetUserId], references: [id], onDelete: Cascade)
  message    Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([reporterId, messageId])
  @@index([status, createdAt])
}

enum SupportTicketStatus {
  /// Waiting on staff.
  OPEN
  /// Staff replied; waiting on the customer.
  PENDING
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

/// One per SUPPORT conversation ("support:<userId>", so one per customer). A customer message on a
/// RESOLVED or CLOSED ticket reopens it.
model SupportTicket {
  id                    String                @id @default(cuid())
  conversationId        String                @unique
  requesterId           String
  assigneeId            String?
  subject               String?
  status                SupportTicketStatus   @default(OPEN)
  priority              SupportTicketPriority @default(NORMAL)
  firstResponseAt       DateTime?
  lastCustomerMessageAt DateTime?
  lastStaffMessageAt    DateTime?
  resolvedAt            DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requester    User         @relation("SupportTicketsRequested", fields: [requesterId], references: [id], onDelete: Cascade)
  assignee     User?        @relation("SupportTicketsAssigned", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([status, priority, updatedAt])
  @@index([assigneeId, status])
  @@index([requesterId])
}

enum NotificationStatus {
  UNREAD
  READ
}

/// Written only through notify() (src/server/notifications/notify.ts), which also pushes it live.
model Notification {
  id         String             @id @default(cuid())
  userId     String
  type       String
  title      String
  body       String?
  link       String?
  status     NotificationStatus @default(UNREAD)
  /// Who caused it, when someone did (the sender of a message, the admin who approved a course).
  actorId    String?
  /// What it is about, e.g. "Course" + id - lets the UI and later jobs find related notifications.
  entityType String?
  entityId   String?
  /// Extra detail for the UI, e.g. { count: 3 } for collapsed messages.
  data       Json?
  /// Unread notifications with the same key collapse into one ("3 new messages from Naima"),
  /// e.g. "conversation:<id>". Reading the conversation clears them.
  groupKey   String?
  readAt     DateTime?
  /// When the worker sent web push / the email digest for it (chat notifications only).
  pushedAt   DateTime?
  emailedAt  DateTime?
  createdAt  DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, groupKey])
  @@index([type, status, pushedAt])
  @@index([type, status, emailedAt])
}

/// A user's choice per notification category (see NOTIFICATION_CATEGORIES); no row = the defaults.
model NotificationPreference {
  userId   String
  category String
  inApp    Boolean
  email    Boolean
  push     Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
}

/// A browser's Web Push subscription (VAPID). Deleted when the push service answers 404 or 410.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Lesson Q&A: a searchable thread per lesson, separate from chat. Upvotes bubble the common
/// questions up; the instructor (or a co-instructor) marks a question answered.
model LessonQuestion {
  id               String    @id @default(cuid())
  lessonId         String
  courseId         String
  userId           String
  title            String
  body             String    @db.Text
  upvotes          Int       @default(0)
  answerCount      Int       @default(0)
  answeredAt       DateTime?
  acceptedAnswerId String?
  pinned           Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  lesson  Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  course  Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers LessonAnswer[]
  votes   LessonQuestionVote[]

  @@index([lessonId, createdAt])
  @@index([courseId, answeredAt])
  @@index([userId])
}

model LessonAnswer {
  id           String   @id @default(cuid())
  questionId   String
  userId       String
  body         String   @db.Text
  /// Written by the course's teacher or a co-instructor - shown with an "Instructor" badge.
  isInstructor Boolean  @default(false)
  /// The answer the instructor (or the asker) marked as the one that settled it.
  accepted     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  question LessonQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([questionId, createdAt])
}

model LessonQuestionVote {
  id         String   @id @default(cuid())
  questionId String
  userId     String
  createdAt  DateTime @default(now())

  question LessonQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([questionId, userId])
}

/** Single-row table (id is always "singleton") for platform-wide toggles admins control at runtime. */
model PlatformSetting {
  id                  String   @id @default("singleton")
  autoApprovePayments Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

/// Fixed-window counters for rate limiting sign-in, sign-up and password reset (src/lib/rate-limit.ts).
/// Postgres-backed until Redis arrives in the real-time phase; one tiny row per key.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

/// Stripe webhook events already handled, keyed by Stripe's event id. Stripe delivers at least
/// once, so a redelivered event is acknowledged without being applied twice
/// (src/server/services/stripe-webhook-service.ts).
model StripeEvent {
  id         String   @id
  type       String
  receivedAt DateTime @default(now())
}
